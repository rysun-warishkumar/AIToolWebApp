# ─── Production (freeaitools.wtechnology.in) ───
# Create as frontend/.env.production before: npm run build

# API base URL
VITE_API_URL=https://freeaitools.wtechnology.in/api

# Public site URL (SEO, canonical, Open Graph, sitemap, llms.txt)
VITE_SITE_URL=https://freeaitools.wtechnology.in

# App metadata
VITE_APP_NAME=Free AI Tools Library
VITE_APP_DESCRIPTION=Free AI tools directory, ChatGPT prompt templates, and AI learning guides

# Google Analytics 4 (optional — injected into index.html at build time)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification (optional)
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code

# Google AdSense (optional — after approval)
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT=xxxxxxxxxx
